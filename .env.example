# Copy to .env and adjust. docker compose reads .env from this directory automatically.
# Never commit your real .env.

ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=reactor
POSTGRES_PASSWORD=reactor
POSTGRES_DB=reactor
POSTGRES_PORT=5432

# Used when running the backend outside docker (e.g. `make test` / uvicorn on the host).
# Inside compose, DATABASE_URL is built from the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://reactor:reactor@localhost:5432/reactor

# --- Backend ---
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# --- Frontend ---
FRONTEND_PORT=5173
